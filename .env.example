# Development only. Bind the server to 127.0.0.1.
DATABASE_URL=sqlite:///./data/local.db
LOCAL_DEVELOPMENT=1
# Set your own random token of at least 32 characters. No token is preconfigured.
LOCAL_API_TOKEN=
# For Supabase mode, unset local development and configure:
# SUPABASE_URL=https://your-project.supabase.co
# DATABASE_URL=postgresql+psycopg://restricted-role:password@host/database
