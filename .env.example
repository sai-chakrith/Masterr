# Development only. Bind the server to 127.0.0.1.
DATABASE_URL=sqlite:///./data/local.db
LOCAL_DEVELOPMENT=1
# Set your own random token of at least 32 characters. No token is preconfigured.
LOCAL_API_TOKEN=
# Optional hosted tutor. Keep this key on the backend only.
GROQ_API_KEY=
MASTRR_LLM_MODEL=openai/gpt-oss-120b
MASTRR_REASONING_EFFORT=low
MASTRR_MAX_COMPLETION_TOKENS=2000
MASTRR_ENV=development
# Explicit reviewer subjects (Supabase user UUIDs); empty grants nobody access.
MASTRR_ADMIN_SUBJECTS=
MASTRR_API_REQUESTS_PER_MINUTE=120
MASTRR_TUTOR_DAILY_CALLS=60
MASTRR_TUTOR_DAILY_TOKEN_BUDGET=120000
MASTRR_TUTOR_GLOBAL_TOKEN_BUDGET=1000000
# Backend only, used for deleting a hosted identity. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# For Supabase mode, unset local development and configure:
# SUPABASE_URL=https://your-project.supabase.co
# DATABASE_URL=postgresql+psycopg://restricted-role:password@host/database
